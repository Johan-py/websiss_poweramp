# ──────────────────────────────────────────────
# WebSISS PowerAmp — Variables de Entorno
# ──────────────────────────────────────────────
# Copia este archivo como .env en la raíz del workspace
# y completa los valores según tu entorno.

# ─── Base de datos (PostgreSQL / Supabase) ────
DATABASE_URL="postgresql://postgres:secret@localhost:5432/websiss_dev?schema=public"
# Solo necesario si usas pgBouncer (Supabase):
# DIRECT_URL="postgresql://postgres:secret@localhost:5432/websiss_dev"

# ─── Supabase Auth ────────────────────────────
# Project Settings → API del panel de Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# ─── API ──────────────────────────────────────
PORT=4000
HOST="0.0.0.0"
NODE_ENV=development

# ─── Web (VITE_) ──────────────────────────────
# Solamente si quieres sobrescribir desde la raíz
# (los VITE_ se cargan automáticamente via envDir)
# VITE_SUPABASE_URL="${SUPABASE_URL}"
# VITE_SUPABASE_ANON_KEY="${SUPABASE_ANON_KEY}"

# ─── Opcionales ──────────────────────────────
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
