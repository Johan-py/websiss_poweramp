# ──────────────────────────────────────────────
# WebSISS PowerAmp — Variables de Entorno
# ──────────────────────────────────────────────
# Copia este archivo como .env y completa los valores

# ─── PostgreSQL Local ──────────────────────────
POSTGRES_USER=websiss
POSTGRES_PASSWORD=websiss_secret
POSTGRES_DB=websiss_dev
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ─── Supabase (producción / staging) ───────────
# Se obtienen del panel de Supabase: Project Settings → API
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# ─── API ───────────────────────────────────────
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV=development

# ─── Rate limiting (opcional) ─────────────────
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
